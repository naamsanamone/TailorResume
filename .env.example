# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tailorresume

# JWT Auth
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRY_HOURS=72

# LLM Configuration (customizable - supports openai, anthropic, gemini, deepseek, ollama)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# For content generation (optional, uses LLM_PROVIDER if not set)
LLM_CONTENT_PROVIDER=
LLM_CONTENT_API_KEY=
LLM_CONTENT_MODEL=
LLM_CONTENT_BASE_URL=

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS
CORS_ORIGINS=["http://localhost:3000","chrome-extension://ajgnfmojakmcoicgnmnfefiliaeikmah"]

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
